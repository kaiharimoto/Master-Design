{
  "id": "std/pop-in",
  "version": "1.0.0",
  "title": "Pop In",
  "description": "Scales up into place with a slight overshoot. Good for badges, buttons and anything that should feel like it arrived with intent.",
  "category": "entrance",
  "tags": ["scale", "pop", "bounce", "overshoot", "entrance"],
  "appliesTo": {
    "minTargets": 1,
    "kinds": ["*"]
  },
  "defaultTrigger": {
    "type": "view",
    "threshold": 0.25,
    "once": true
  },
  "params": [
    {
      "key": "startScale",
      "label": "Start scale",
      "type": "number",
      "min": 0,
      "max": 2,
      "step": 0.05,
      "unit": "×",
      "default": 0.8,
      "description": "Values above 1 shrink into place instead of growing."
    },
    {
      "key": "duration",
      "label": "Duration",
      "type": "number",
      "min": 0.05,
      "max": 3,
      "step": 0.05,
      "unit": "s",
      "default": 0.5
    },
    {
      "key": "stagger",
      "label": "Stagger",
      "type": "number",
      "min": 0,
      "max": 2,
      "step": 0.01,
      "unit": "s",
      "default": 0.06
    },
    {
      "key": "easing",
      "label": "Easing",
      "type": "easing",
      "default": { "cubicBezier": [0.34, 1.56, 0.64, 1] },
      "description": "The default curve overshoots past 1 and settles back — that overshoot is what makes it read as a pop rather than a grow."
    }
  ],
  "generator": {
    "kind": "declarative",
    "duration": "duration + stagger * (count - 1)",
    "perTarget": {
      "startAt": "stagger * index",
      "endAt": "stagger * index + duration",
      "tracks": [
        { "property": "opacity", "from": 0, "to": 1, "easing": "easeOut" },
        { "property": "scale", "from": "=startScale", "to": 1 }
      ]
    }
  }
}
