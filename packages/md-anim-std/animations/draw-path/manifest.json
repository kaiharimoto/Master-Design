{
  "id": "std/draw-path",
  "version": "1.0.0",
  "title": "Draw Path",
  "description": "A stroked path draws itself on, as though being written. Reads the real arc length of each path, so lines of different lengths draw at a matched speed rather than a matched duration.",
  "category": "entrance",
  "tags": ["draw", "line", "stroke", "write", "signature", "entrance"],
  "appliesTo": {
    "minTargets": 1,
    "kinds": ["path"]
  },
  "defaultTrigger": {
    "type": "view",
    "threshold": 0.3,
    "once": true
  },
  "params": [
    {
      "key": "duration",
      "label": "Duration",
      "type": "number",
      "min": 0.1,
      "max": 10,
      "step": 0.1,
      "unit": "s",
      "default": 1.2,
      "description": "How long one path takes to draw."
    },
    {
      "key": "stagger",
      "label": "Stagger",
      "type": "number",
      "min": 0,
      "max": 3,
      "step": 0.05,
      "unit": "s",
      "default": 0.15,
      "description": "Delay between consecutive paths."
    },
    {
      "key": "easing",
      "label": "Easing",
      "type": "easing",
      "default": "easeInOut",
      "description": "Ease-in-out mimics a hand accelerating and slowing at the ends of a stroke."
    }
  ],
  "generator": {
    "kind": "declarative",
    "duration": "duration + stagger * (count - 1)",
    "perTarget": {
      "startAt": "stagger * index",
      "endAt": "stagger * index + duration",
      "tracks": [
        {
          "property": "strokeDashoffset",
          "from": "=pathLength",
          "to": 0
        }
      ]
    }
  }
}
